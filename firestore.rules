rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper -------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAsisten() {
      return signedIn() && myProfile().get('role', '') == 'asisten';
    }

    function isPraktikan() {
      return signedIn() && myProfile().get('role', '') == 'praktikan';
    }

    function sessionOf(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    function classOf(kelasId) {
      return get(/databases/$(database)/documents/classes/$(kelasId)).data;
    }

    // --- allowedAssistants --------------------------------------------------
    // Daftar email yang boleh mendaftar sebagai asisten. ID dokumen = email dengan
    // HURUF KECIL (contoh: "asisten1@gmail.com"); isi dokumen bebas.
    // Hanya diisi admin lewat Firebase Console (Console melewati rules).
    // - Baca : hanya dokumen berisi email milik pengguna yang sedang login (get, bukan list),
    //          jadi daftar lengkap tidak bisa diintip.
    // - Tulis: tidak boleh dari klien.
    match /allowedAssistants/{email} {
      allow get: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // Email Auth pengguna ada di allowedAssistants (dipakai saat registrasi asisten).
    function isAllowedAssistantEmail() {
      return request.auth.token.email != null
        && exists(/databases/$(database)/documents/allowedAssistants/$(request.auth.token.email.lower()));
    }

    // --- users --------------------------------------------------------------
    // - Baca: pemilik dokumen, asisten (daftar peserta), atau praktikan yang
    //          membutuhkan nama asisten pada dashboard.
    // - Buat : registrasi dokumen milik uid sendiri. Praktikan: terbuka (NIM wajib, kelasIds kosong).
    //          Asisten: hanya jika email Auth-nya ada di allowedAssistants (tanpa NIM/kelasIds).
    // - Ubah : hanya asisten, hanya field kelasIds milik praktikan.
    // - Hapus: tidak boleh.
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isAsisten()
        || (isPraktikan() && resource.data.role == 'asisten')
      );

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['nama', 'email', 'role'])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 3
        && request.resource.data.nama.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && (
          // Praktikan
          (request.resource.data.role == 'praktikan'
            && request.resource.data.keys().hasOnly(['nama', 'email', 'role', 'nim', 'kelasIds', 'createdAt'])
            && request.resource.data.keys().hasAll(['nim'])
            && request.resource.data.nim is string
            && request.resource.data.nim.matches('^[0-9]{5,20}$')
            && (!('kelasIds' in request.resource.data) || request.resource.data.kelasIds.size() == 0))
          ||
          // Asisten (email harus terdaftar di allowedAssistants)
          (request.resource.data.role == 'asisten'
            && request.resource.data.keys().hasOnly(['nama', 'email', 'role', 'createdAt'])
            && isAllowedAssistantEmail())
        );

      allow update: if isAsisten()
        && resource.data.role == 'praktikan'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kelasIds'])
        && request.resource.data.kelasIds is list;

      allow delete: if false;
    }

    // --- classes ------------------------------------------------------------
    // Baca: semua pengguna login. Tulis: hanya asisten pemilik kelas.
    match /classes/{classId} {
      allow read: if signedIn();

      allow create: if isAsisten()
        && request.resource.data.keys().hasOnly(['namaKelas', 'praktikum', 'asistenId', 'pesertaIds'])
        && request.resource.data.keys().hasAll(['namaKelas', 'praktikum', 'asistenId', 'pesertaIds'])
        && request.resource.data.asistenId == request.auth.uid
        && request.resource.data.pesertaIds is list
        && request.resource.data.pesertaIds.size() == 0;

      allow update: if isAsisten()
        && resource.data.asistenId == request.auth.uid
        && request.resource.data.asistenId == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['namaKelas', 'praktikum', 'pesertaIds']);

      allow delete: if isAsisten() && resource.data.asistenId == request.auth.uid;
    }

    // --- sessions -----------------------------------------------------------
    // Baca: asisten pemilik sesi, atau praktikan yang kelasnya cocok.
    // Tulis: hanya asisten pemilik sesi; status hanya boleh maju satu langkah.
    match /sessions/{sessionId} {
      allow read: if signedIn() && (
        (isAsisten() && resource.data.asistenId == request.auth.uid)
        || (isPraktikan() && resource.data.kelasId in myProfile().get('kelasIds', []))
      );

      allow create: if isAsisten()
        && request.resource.data.keys().hasOnly([
             'praktikum', 'kelasId', 'asistenId', 'tanggal', 'waktuMulai',
             'waktuSelesai', 'ruangan', 'status'
           ])
        && request.resource.data.keys().hasAll([
             'praktikum', 'kelasId', 'asistenId', 'tanggal', 'waktuMulai',
             'waktuSelesai', 'ruangan', 'status'
           ])
        && request.resource.data.asistenId == request.auth.uid
        && request.resource.data.status == 'belum_dibuka'
        && classOf(request.resource.data.kelasId).asistenId == request.auth.uid;

      allow update: if isAsisten()
        && resource.data.asistenId == request.auth.uid
        && request.resource.data.asistenId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'praktikum', 'kelasId', 'tanggal', 'waktuMulai', 'waktuSelesai',
             'ruangan', 'status', 'openedAt', 'closedAt'
           ])
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'belum_dibuka' && request.resource.data.status == 'dibuka')
          || (resource.data.status == 'dibuka' && request.resource.data.status == 'ditutup')
        )
        && (
          resource.data.status != 'ditutup'
          || request.resource.data.status == resource.data.status
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['praktikum', 'kelasId', 'tanggal', 'waktuMulai', 'waktuSelesai', 'ruangan'])
          || resource.data.status == 'belum_dibuka'
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kelasId'])
          || classOf(request.resource.data.kelasId).asistenId == request.auth.uid
        );

      allow delete: if isAsisten()
        && resource.data.asistenId == request.auth.uid
        && resource.data.status == 'belum_dibuka';
    }

    // --- attendances --------------------------------------------------------
    // Mendukung dua format dokumen yang dipakai layar:
    //   {sessionId}_{uid}         + name/nim/checkedInAt   (attendanceService)
    //   att-{sessionId}-{uid}     + nama/nim/waktuHadir    (sessionService)
    match /attendances/{attId} {
      allow read: if signedIn() && (
        (isPraktikan() && resource.data.userId == request.auth.uid)
        || (isAsisten() && sessionOf(resource.data.sessionId).asistenId == request.auth.uid)
      );

      allow create: if isPraktikan()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sessionId is string
        && sessionOf(request.resource.data.sessionId).status == 'dibuka'
        && sessionOf(request.resource.data.sessionId).kelasId in myProfile().get('kelasIds', [])
        && (
          (
            attId == (request.resource.data.sessionId + '_' + request.auth.uid)
            && request.resource.data.keys().hasOnly(['sessionId', 'userId', 'name', 'nim', 'checkedInAt'])
            && request.resource.data.keys().hasAll(['sessionId', 'userId', 'name', 'nim', 'checkedInAt'])
            && request.resource.data.name == myProfile().nama
            && request.resource.data.nim == myProfile().get('nim', '')
            && request.resource.data.checkedInAt == request.time
          )
          ||
          (
            attId == ('att-' + request.resource.data.sessionId + '-' + request.auth.uid)
            && request.resource.data.keys().hasOnly([
                 'sessionId', 'kelasId', 'userId', 'nama', 'nim', 'waktuHadir'
               ])
            && request.resource.data.keys().hasAll([
                 'sessionId', 'kelasId', 'userId', 'nama', 'nim', 'waktuHadir'
               ])
            && request.resource.data.kelasId == sessionOf(request.resource.data.sessionId).kelasId
            && request.resource.data.nama == myProfile().nama
            && request.resource.data.nim == myProfile().get('nim', '')
            && request.resource.data.waktuHadir == request.time
          )
        );

      allow update, delete: if false;
    }

    // --- leaveRequests ------------------------------------------------------
    // Baca: pemilik atau asisten pengampu. Buat: praktikan untuk sesi kelasnya.
    // Ubah: hanya asisten pengampu, status menunggu -> diterima/ditolak.
    match /leaveRequests/{leaveId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (isAsisten() && resource.data.asistenId == request.auth.uid)
      );

      allow create: if isPraktikan()
        && request.resource.data.keys().hasOnly([
             'sessionId', 'kelasId', 'asistenId', 'praktikum', 'userId',
             'nama', 'nim', 'alasan', 'kategoriAI', 'aiStatus', 'status', 'createdAt'
           ])
        && request.resource.data.keys().hasAll([
             'sessionId', 'kelasId', 'asistenId', 'userId', 'alasan', 'aiStatus', 'status'
           ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'menunggu'
        && request.resource.data.sessionId is string
        && request.resource.data.alasan is string
        && request.resource.data.alasan.size() >= 10
        && request.resource.data.alasan.size() <= 300
        && request.resource.data.nama == myProfile().nama
        && request.resource.data.nim == myProfile().get('nim', '')
        && request.resource.data.kelasId in myProfile().get('kelasIds', [])
        && sessionOf(request.resource.data.sessionId).kelasId == request.resource.data.kelasId
        && sessionOf(request.resource.data.sessionId).asistenId == request.resource.data.asistenId
        && sessionOf(request.resource.data.sessionId).status != 'ditutup'
        && request.resource.data.aiStatus in ['berhasil', 'gagal']
        && (
          request.resource.data.kategoriAI == null
          || request.resource.data.kategoriAI in ['negatif', 'netral', 'positif']
        )
        && (
          !('createdAt' in request.resource.data)
          || request.resource.data.createdAt == request.time
        );

      allow update: if isAsisten()
        && resource.data.asistenId == request.auth.uid
        && resource.data.status == 'menunggu'
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status', 'catatanAsisten'])
        && request.resource.data.status in ['diterima', 'ditolak']
        && (
          !('catatanAsisten' in request.resource.data)
          || (
            request.resource.data.catatanAsisten is string
            && request.resource.data.catatanAsisten.size() <= 500
          )
        );

      allow delete: if false;
    }

    // --- Default: tolak koleksi lain ----------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
