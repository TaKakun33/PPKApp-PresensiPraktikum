{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Validate SRS-23 lint",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint - stylish"
			]
		},
		{
			"label": "Validate SRS-23 lint via cmd",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint - stylish"
			]
		},
		{
			"label": "Validate SRS-23 TypeScript",
			"type": "shell",
			"command": "npx.cmd",
			"args": [
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Restore locked project dependencies",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"ci"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install dependencies for checks",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"install",
				"--package-lock=false"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final SRS-23 lint",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint - stylish"
			]
		},
		{
			"label": "Verify SRS-23 lint",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint - stylish"
			]
		},
		{
			"label": "Verify SRS-23 TypeScript",
			"type": "shell",
			"command": "npx.cmd",
			"args": [
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Check SRS-23 diff",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"git status --short && git diff --check"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check SRS-23 git status",
			"type": "shell",
			"command": "git.exe",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check SRS-23 whitespace",
			"type": "shell",
			"command": "git.exe",
			"args": [
				"diff",
				"--check"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "TypeScript compiler check",
			"type": "shell",
			"command": "npx",
			"args": [
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		}
	]
}